{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "everything_explorer2",
    "version": "0.1.0",
    "identifier": "net.hillemanns.tobias.everything.explorer",
    "build": {
        "beforeDevCommand": "nub run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "nub run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {"title": "Everything Explorer", "width": 800, "height": 600}
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "connect-src": "ipc: http://ipc.localhost http://localhost:3000"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
