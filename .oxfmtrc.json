{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": [],
    "printWidth": 80,
    "tabWidth": 4,
    "sortImports": true,
    "sortTailwindcss": true,
    "arrowParens": "avoid",
    "experimentalOperatorPosition": "start",
    "jsdoc": {"commentLineStrategy": "multiline", "preferCodeFences": true},
    "objectWrap": "collapse",
    "proseWrap": "always",
    "bracketSpacing": false
}
